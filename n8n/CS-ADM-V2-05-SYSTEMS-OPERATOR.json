    {
      "parameters": {
        "jsCode": "const req=$input.first().json;\nconst h=req.headers||{};\nconst supplied=h['x-iuc-agent-secret']||h['X-IUC-Agent-Secret']||'';\nconst expected=$vars.N8N_EVENT_SHARED_SECRET;\nif(supplied!==expected) throw new Error('Invalid Systems Operator secret');\nconst e=req.body||req;\nif(!e.referenceNo) throw new Error('referenceNo required');\nreturn [{json:{...e,agentId:'SYSTEMS_OPERATOR',executionId:'SYS-'+e.referenceNo+'-'+(e.eventId||Date.now())}}];"
      },
      "id": "prepare",
      "name": "Prepare Systems Task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://anasbukhori.app.n8n.cloud/webhook/cs-adm-v2-action-gateway",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IUC-Agent-Secret",
              "value": "={{ $vars.N8N_EVENT_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({operation:'state',referenceNo:$json.referenceNo}) }}",
        "options": {}
      },
      "id": "state-before",
      "name": "Read SKY State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -250,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const s=$input.first().json;\nconst w=s.workflow||{};\nconst prospect=String(w['Prospect Status']||'').toUpperCase();\nconst fee=String(w['Fee Group']||'').trim();\nconst prospectId=String(w['SKY Prospect ID']||'').trim();\nconst activated=String(w['SKY Activation Status']||'').toUpperCase()==='ACTIVATED';\nif(!activated){\n  if(!['PROSPECT_COMPLETED','PROSPECT_UPDATED'].includes(prospect)) throw new Error('Marketing Prospect completion is not confirmed');\n  if(!prospectId) throw new Error('SKY Prospect ID missing');\n  if(!fee) throw new Error('Fee Group missing');\n}\nreturn [{json:{referenceNo:s.referenceNo,prospectStatus:prospect,skyProspectId:prospectId,feeGroup:fee,alreadyActivated:activated,verifiedBefore:true}}];"
      },
      "id": "verify-before",
      "name": "Verify SKY Readiness",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        0
      ]
    },
    {

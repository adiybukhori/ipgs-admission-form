    {
      "parameters": {
        "jsCode": "const s=$input.first().json;\nconst w=s.workflow||{};\nconst exec=$('Prepare Registry SKY Activation').item.json||{};\nconst activation=String(w['SKY Activation Status']||'NOT_ACTIVATED').toUpperCase();\nconst acceptance=String(w['Acceptance Status']||'').toUpperCase();\nconst resultStatus=String(exec.result?.status||exec.status||'').toUpperCase();\nconst waitingHuman=exec.requiresHuman===true || resultStatus==='WAITING_HUMAN';\nconst activationReady=['READY_FOR_ACTIVATION','PENDING_ACTIVATION','WAITING_HUMAN'].includes(resultStatus);\nconst routeOrientation=activation==='ACTIVATED' && acceptance==='ACCEPTED';\nif(!waitingHuman && !activationReady && activation!=='ACTIVATED'){\n  throw new Error('Systems Operator verification failed: expected SKY activation task/readiness or ACTIVATED state');\n}\nreturn [{json:{ok:true,referenceNo:s.referenceNo,skyProspectId:w['SKY Prospect ID']||'',feeGroup:w['Fee Group']||'',skyActivationStatus:activation,acceptanceStatus:acceptance,resultStatus,requiresHuman:waitingHuman,activationReady,routeOrientation,verified:true}}];"
      },
      "id": "verify-after",

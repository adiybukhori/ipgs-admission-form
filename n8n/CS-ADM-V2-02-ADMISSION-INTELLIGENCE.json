        "jsCode": "const s=$input.first().json;\nconst ai=s.aiScreening||{};\nconst q=s.qualificationScreening||{};\nconst w=s.workflow||{};\nconst reportStatus=String(ai['Report Status']||ai['Screening Report Status']||'').toUpperCase();\nconst reportUrl=String(ai['Report PDF URL']||ai['Screening Report URL']||'').trim();\nconst stage=String(w['Application Stage']||'').toUpperCase();\nconst human=/REVIEW_REQUIRED|PENDING_HUMAN|AUTO_FAILED/.test(String(ai['Status']||'')+' '+reportStatus) || String(w['Manual Review Required']||'').toUpperCase()==='YES';\nconst reportReady=reportStatus==='FINAL' && Boolean(reportUrl);\nconst completed=human || ['READY_FOR_SAC','QUALIFICATION_SCREENING'].includes(stage);\nif(!completed) throw new Error('Post-action verification failed');\nif(!human && stage==='READY_FOR_SAC' && !reportReady){\n  throw new Error('SAC gate blocked: FINAL AI Screening Report PDF was not verified');\n}\nreturn [{json:{\n  ok:true,\n  referenceNo:s.referenceNo,\n  verified:true,\n  requiresHuman:human,\n  applicationStage:stage,\n  aiStatus:ai['Status']||'',\n  reportStatus,\n  reportUrl,\n  reportReady,\n  recommendedRoute:q['Recommended Route']||w['Screening Recommendation']||'',\n  routeToSac:!human&&stage==='READY_FOR_SAC'&&reportReady\n}}];"

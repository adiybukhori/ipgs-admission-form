          "parameters": [
            {
              "name": "X-IUC-Agent-Secret",
              "value": "={{ $vars.N8N_EVENT_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({operation:'execute',executionId:$('Prepare Systems Task').item.json.executionId,referenceNo:$('Prepare Systems Task').item.json.referenceNo,agentId:'SYSTEMS_OPERATOR',requestedAction:'PREPARE_SKY_ACTIVATION'}) }}",
        "options": {}
      },
      "id": "execute",
      "name": "Prepare Registry SKY Activation",

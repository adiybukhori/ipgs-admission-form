      "parameters": {
        "jsCode": "const now=new Date();\nconst slot=Math.floor(now.getTime()/(15*60*1000));\nreturn [{json:{\n  operation:'execute',\n  executionId:'ORI-SUP-'+slot,\n  agentId:'ORIENTATION',\n  requestedAction:'RUN_ORIENTATION_SUPERVISOR',\n  closeGraceMinutes:30\n}}];"
      },

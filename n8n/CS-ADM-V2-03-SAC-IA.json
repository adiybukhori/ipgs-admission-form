        "body": "={{ JSON.stringify({operation:'execute',executionId:$('Prepare SAC IA Task').item.json.executionId,referenceNo:$('Prepare SAC IA Task').item.json.referenceNo,agentId:'SAC_IA',requestedAction:$json.requestedAction}) }}",
        "options": {}
      },

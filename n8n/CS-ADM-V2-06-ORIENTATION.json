      },
      "id": "orientation-webhook",
      "name": "Orientation Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -700,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const req=$input.first().json;\nconst h=req.headers||{};\nconst supplied=h['x-iuc-agent-secret']||h['X-IUC-Agent-Secret']||'';\nconst expected='REPLACE_WITH_N8N_EVENT_SHARED_SECRET';\nif(supplied!==expected) throw new Error('Invalid Orientation Agent secret');\nconst e=req.body||req;\nif(!e.referenceNo) throw new Error('referenceNo required');\nreturn [{json:{...e,agentId:'ORIENTATION',executionId:'ORI-'+e.referenceNo+'-'+(e.eventId||Date.now())}}];"
      },
      "id": "prepare",
      "name": "Prepare Orientation Task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -480,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://anasbukhori.app.n8n.cloud/webhook/cs-adm-v2-action-gateway",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IUC-Agent-Secret",
              "value": "REPLACE_WITH_N8N_EVENT_SHARED_SECRET"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({operation:'state',referenceNo:$json.referenceNo}) }}",
        "options": {}
      },
      "id": "state-before",
      "name": "Read Orientation State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -250,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const s=$input.first().json;\nconst w=s.workflow||{};\nconst stage=String(w['Application Stage']||'').toUpperCase();\nconst acceptance=String(w['Acceptance Status']||'').toUpperCase();\nif(stage!=='ACCEPTED' && acceptance!=='ACCEPTED') throw new Error('Orientation Agent blocked: applicant is not ACCEPTED');\nreturn [{json:{referenceNo:s.referenceNo,stage,acceptanceStatus:acceptance,verifiedBefore:true}}];"
      },
      "id": "verify-before",
      "name": "Verify Accepted Student",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://anasbukhori.app.n8n.cloud/webhook/cs-adm-v2-action-gateway",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IUC-Agent-Secret",
              "value": "REPLACE_WITH_N8N_EVENT_SHARED_SECRET"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({operation:'execute',executionId:$('Prepare Orientation Task').item.json.executionId,referenceNo:$('Prepare Orientation Task').item.json.referenceNo,agentId:'ORIENTATION',requestedAction:'PREPARE_ORIENTATION_FOR_ACCEPTED'}) }}",
        "options": {}
      },
      "id": "execute",
      "name": "Assign Invite Verify Orientation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,

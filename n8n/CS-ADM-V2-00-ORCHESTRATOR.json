        "jsCode": "const req=$input.first().json;\nconst h=req.headers||{};\nconst supplied=h['x-iuc-agent-secret']||h['X-IUC-Agent-Secret']||'';\nconst expected='REPLACE_WITH_N8N_EVENT_SHARED_SECRET';\nif(supplied!==expected) throw new Error('Invalid orchestrator secret');\nconst e=req.body||req;\nconst eventType=String(e.eventType||'').toUpperCase();\nconst toStage=String(e.toStage||e.data?.nextStage||'').toUpperCase();\nlet target='NO_ROUTE';\n\nconst routes={\n  APPLICATION_SUBMITTED:'DOCUMENT_AUTOMATION',\n  DOCUMENT_COMPLETENESS_CONFIRMED:'COMPLIANCE',\n  DOCUMENT_REVIEW_COMPLETED:'COMPLIANCE',\n  DOCUMENT_REPLACEMENT_RECEIVED:'COMPLIANCE',\n  DOCUMENT_QUALITY_PASSED:'ADMISSION_INTELLIGENCE',\n  DOCUMENT_REPLACEMENT_REQUIRED:'STUDENT_CONCIERGE',\n  SCREENING_READY_FOR_SAC:'SAC_IA',\n  ACCEPTANCE_COMPLETED:'ORIENTATION',\n  PROSPECT_COMPLETED:'SYSTEMS_OPERATOR',\n  SKY_ACTIVATION_READY:'SYSTEMS_OPERATOR',\n  ORIENTATION_COMPLETED:'ACADEMIC_HANDOVER',\n  PROVISIONING_READY_TO_NOTIFY:'ACADEMIC_HANDOVER'\n};\n\ntarget=routes[eventType]||'NO_ROUTE';\n\nif(['SAC_DECISION_RECORDED','IA_OUTCOME_RECORDED','PREREQUISITE_OUTCOME_RECORDED'].includes(eventType)){\n  target=toStage==='ELIGIBLE_FOR_OFFER'?'OFFER_AUTOMATION':'SAC_IA';\n}\n\nreturn [{json:{...e,targetAgent:target,resolvedToStage:toStage}}];"
      },

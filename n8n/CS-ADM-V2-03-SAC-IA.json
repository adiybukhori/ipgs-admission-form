      "id": "state-after",
      "name": "Read SAC IA State After",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        600,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "const s=$input.first().json;\nconst w=s.workflow||{};\nconst before=$('Decide SAC IA Action').item.json;\nconst stage=String(w['Application Stage']||'').toUpperCase();\nconst action=String(before.requestedAction||'');\nlet verified=false;\nif(action==='PREPARE_SAC_COORDINATION') verified=['READY_FOR_SAC','SAC_REVIEW'].includes(stage);\nif(action==='PREPARE_IA_COORDINATION') verified=stage==='INTERNAL_ASSESSMENT';\nif(action==='PREPARE_PREREQUISITE_COORDINATION') verified=stage==='PREREQUISITE';\nif(!verified) throw new Error('SAC / IA post-action verification failed for '+action+' at '+stage);\nreturn [{json:{ok:true,referenceNo:s.referenceNo,requestedAction:action,applicationStage:stage,verified:true}}];"
      },
      "id": "verify-after",
      "name": "Verify SAC IA Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        830,
        -100
      ]
    },
    {

    {
      "parameters": {
        "jsCode": "const s=$input.first().json;\nconst w=s.workflow||{};\nconst handover=String(w['Academic Handover Status']||'NOT_READY').toUpperCase();\nconst orientation=String(w['Orientation Status']||'').toUpperCase();\nconst provision=String(w['Provisioning Status']||'').toUpperCase();\nconst acceptance=String(w['Acceptance Status']||'').toUpperCase();\nconst skyActivation=String(w['SKY Activation Status']||'NOT_ACTIVATED').toUpperCase();\nconst stage=String(w['Application Stage']||'').toUpperCase();\nconst accepted=acceptance==='ACCEPTED' || ['ACCEPTED','ORIENTATION','ACADEMIC_HANDOVER','ACTIVE_STUDENT'].includes(stage);\n\nlet action='NO_ACTION';\nif(\n  handover==='READY' &&\n  orientation==='COMPLETED' &&\n  accepted &&\n  skyActivation==='ACTIVATED'\n){\n  action='PREPARE_ACADEMIC_HANDOVER';\n}else if(\n  handover==='HANDED_OVER' &&\n  provision==='READY_TO_NOTIFY'\n){\n  action='PREPARE_STUDENT_ACCESS_DELIVERY';\n}\n\nreturn [{json:{\n  referenceNo:s.referenceNo,\n  requestedAction:action,\n  academicHandoverStatus:handover,\n  orientationStatus:orientation,\n  acceptanceStatus:acceptance,\n  skyActivationStatus:skyActivation,\n  provisioningStatus:provision,\n  verifiedBefore:true\n}}];"
      },

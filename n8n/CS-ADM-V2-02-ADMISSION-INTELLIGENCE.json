        "jsCode": "const req=$input.first().json; const h=req.headers||{}; const supplied=h['x-iuc-agent-secret']||h['X-IUC-Agent-Secret']||''; const expected='REPLACE_WITH_N8N_EVENT_SHARED_SECRET'; if(supplied!==expected) throw new Error('Invalid Admission Intelligence secret'); const e=req.body||req; if(!e.referenceNo) throw new Error('referenceNo required'); return [{json:{...e,agentId:'ADMISSION_INTELLIGENCE',executionId:'AI-'+e.referenceNo+'-'+(e.eventId||Date.now())}}];"
      },

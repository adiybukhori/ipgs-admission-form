    {
      "parameters": {
        "jsCode": "const s=$input.first().json;\nconst w=s.workflow||{};\nconst provisioning=s.provisioning||{};\nconst handover=String(w['Academic Handover Status']||'NOT_READY').toUpperCase();\nconst orientation=String(w['Orientation Status']||'').toUpperCase();\nconst provision=String(w['Provisioning Status']||'').toUpperCase();\nlet action='NO_ACTION';\nif(handover==='READY' && orientation==='COMPLETED') action='PREPARE_ACADEMIC_HANDOVER';\nelse if(provision==='READY_TO_NOTIFY' || (\n  String(provisioning['IT Email Status']||'').toUpperCase()==='COMPLETED' &&\n  String(provisioning['Moodle Status']||'').toUpperCase()==='COMPLETED' &&\n  String(provisioning['E-Library Status']||'').toUpperCase()==='COMPLETED' &&\n  String(provisioning['Student Notification Status']||'').toUpperCase()!=='SENT'\n)) action='PREPARE_STUDENT_ACCESS_DELIVERY';\nreturn [{json:{referenceNo:s.referenceNo,requestedAction:action,academicHandoverStatus:handover,orientationStatus:orientation,provisioningStatus:provision,verifiedBefore:true}}];"
      },
      "id": "decide",
      "name": "Decide Handover Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [

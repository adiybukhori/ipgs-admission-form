        "jsCode": "const s=$input.first().json;\nconst d=s.documentReview||{};\nconst w=s.workflow||{};\nconst quality=String(d['AI Quality Status']||w['Document Quality Status']||'').toUpperCase();\nif(quality!=='FOLLOW_UP_REQUIRED') throw new Error('Student Concierge replacement task blocked: quality status is '+(quality||'NOT_SET'));\nlet follow=[];\ntry{follow=JSON.parse(String(d['AI Quality Follow-up JSON']||'[]'));}catch(_){}\nif(!Array.isArray(follow)||!follow.length) throw new Error('No replacement instruction is available');\nreturn [{json:{referenceNo:s.referenceNo,qualityStatus:quality,followUpCount:follow.length,verifiedBefore:true}}];"
      },
      "id": "verify-before",

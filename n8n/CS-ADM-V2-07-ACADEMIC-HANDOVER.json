    {
      "parameters": {
        "jsCode": "const s=$input.first().json;\nconst w=s.workflow||{};\nconst exec=$('Execute Handover Coordination').item.json||{};\nconst action=String($('Decide Handover Action').item.json.requestedAction||'');\nconst handover=String(w['Academic Handover Status']||'').toUpperCase();\nconst provision=String(w['Provisioning Status']||'').toUpperCase();\nconst waitingHuman=exec.requiresHuman===true || String(exec.status||'').toUpperCase()==='WAITING_HUMAN';\nif(!waitingHuman){\n  if(action==='PREPARE_ACADEMIC_HANDOVER' && !['HANDED_OVER','COMPLETED'].includes(handover)){\n    throw new Error('Handover verification failed: '+handover);\n  }\n  if(action==='PREPARE_STUDENT_ACCESS_DELIVERY' && !['READY_TO_NOTIFY','COMPLETED'].includes(provision)){\n    throw new Error('Student access preparation verification failed: '+provision);\n  }\n}\nreturn [{json:{ok:true,referenceNo:s.referenceNo,requestedAction:action,academicHandoverStatus:handover,provisioningStatus:provision,requiresHuman:waitingHuman,verified:true}}];"
      },

    {
      "parameters": {
        "jsCode": "const s=$input.first().json;\nconst w=s.workflow||{};\nconst exec=$('Execute Handover Coordination').item.json||{};\nconst before=$('Decide Handover Action').item.json||{};\nconst action=String(before.requestedAction||'');\nconst handover=String(w['Academic Handover Status']||'').toUpperCase();\nconst provision=String(w['Provisioning Status']||'').toUpperCase();\nconst waitingHuman=exec.requiresHuman===true || String(exec.status||'').toUpperCase()==='WAITING_HUMAN';\n\nif(!waitingHuman){\n  if(action==='PREPARE_ACADEMIC_HANDOVER' && !['HANDED_OVER','COMPLETED'].includes(handover)){\n    throw new Error('Handover verification failed: '+handover);\n  }\n  if(action==='PREPARE_STUDENT_ACCESS_DELIVERY' && handover!=='HANDED_OVER'){\n    throw new Error('Student access preparation requires HANDED_OVER state: '+handover);\n  }\n  if(action==='PREPARE_STUDENT_ACCESS_DELIVERY' && !['READY_TO_NOTIFY','COMPLETED'].includes(provision)){\n    throw new Error('Student access preparation verification failed: '+provision);\n  }\n}\n\nreturn [{json:{\n  ok:true,\n  referenceNo:s.referenceNo,\n  requestedAction:action,\n  academicHandoverStatus:handover,\n  provisioningStatus:provision,\n  requiresHuman:waitingHuman,\n  verified:true\n}}];"
      },

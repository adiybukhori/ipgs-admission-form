    {
      "parameters": {
        "jsCode": "const req=$input.first().json;\nconst h=req.headers||{};\nconst supplied=h['x-iuc-agent-secret']||h['X-IUC-Agent-Secret']||'';\nconst expected=$vars.N8N_EVENT_SHARED_SECRET;\nif(supplied!==expected) throw new Error('Invalid Academic Handover Agent secret');\nconst e=req.body||req;\nif(!e.referenceNo) throw new Error('referenceNo required');\nreturn [{json:{...e,agentId:'ACADEMIC_HANDOVER',executionId:'HND-'+e.referenceNo+'-'+(e.eventId||Date.now())}}];"
      },
      "id": "prepare",
      "name": "Prepare Handover Task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -540,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://anasbukhori.app.n8n.cloud/webhook/cs-adm-v2-action-gateway",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IUC-Agent-Secret",
              "value": "={{ $vars.N8N_EVENT_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",

        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({operation:'state',referenceNo:$('Prepare Orientation Task').item.json.referenceNo}) }}",
        "options": {}
      },
      "id": "state-after",
      "name": "Read Orientation State After",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        450,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const s=$input.first().json;\nconst w=s.workflow||{};\nconst o=s.orientation||{};\nconst exec=$('Assign Invite Verify Orientation').item.json||{};\nconst stage=String(w['Application Stage']||'').toUpperCase();\nconst sessionId=String(w['Orientation Session ID']||o['Orientation Session ID']||'');\nconst invitation=String(o['Invitation Status']||'').toUpperCase();\nconst waitingHuman=exec.requiresHuman===true || String(exec.status||'').toUpperCase()==='WAITING_HUMAN';\nif(!waitingHuman){\n  if(!sessionId) throw new Error('Orientation verification failed: Session ID not recorded');\n  if(invitation!=='SENT') throw new Error('Orientation verification failed: invitation is '+(invitation||'NOT_SET'));\n}\nreturn [{json:{\n  ok:true,\n  referenceNo:s.referenceNo,\n  applicationStage:stage,\n  orientationSessionId:sessionId,\n  invitationStatus:invitation,\n  requiresHuman:waitingHuman,\n  resultStatus:exec.status||'',\n  verified:true\n}}];"
      },
      "id": "verify-after",
      "name": "Verify Orientation Result",
      "type": "n8n-nodes-base.code",

      "id": "sac-webhook",
      "name": "SAC IA Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -760,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const req=$input.first().json;\nconst h=req.headers||{};\nconst supplied=h['x-iuc-agent-secret']||h['X-IUC-Agent-Secret']||'';\nconst expected=$vars.N8N_EVENT_SHARED_SECRET;\nif(supplied!==expected) throw new Error('Invalid SAC / IA Agent secret');\nconst e=req.body||req;\nif(!e.referenceNo) throw new Error('referenceNo required');\nreturn [{json:{...e,agentId:'SAC_IA',executionId:'SACIA-'+e.referenceNo+'-'+(e.eventId||Date.now())}}];"
      },
      "id": "prepare",
      "name": "Prepare SAC IA Task",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -540,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://anasbukhori.app.n8n.cloud/webhook/cs-adm-v2-action-gateway",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IUC-Agent-Secret",
              "value": "={{ $vars.N8N_EVENT_SHARED_SECRET }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({operation:'state',referenceNo:$json.referenceNo}) }}",
        "options": {}
      },
      "id": "state-before",
      "name": "Read SAC IA State",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -320,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const s=$input.first().json;\nconst w=s.workflow||{};\nconst stage=String(w['Application Stage']||'').toUpperCase();\nlet action='';\nif(['READY_FOR_SAC','SAC_REVIEW'].includes(stage)) action='PREPARE_SAC_COORDINATION';\nelse if(stage==='INTERNAL_ASSESSMENT') action='PREPARE_IA_COORDINATION';\nelse if(stage==='PREREQUISITE') action='PREPARE_PREREQUISITE_COORDINATION';\nelse action='NO_ACTION';\nreturn [{json:{referenceNo:s.referenceNo,stage,requestedAction:action,verifiedBefore:true}}];"
      },
      "id": "decide",
      "name": "Decide SAC IA Action",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -90,
        0
      ]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.requestedAction }}",
                    "rightValue": "NO_ACTION",
                    "operator": {
                      "type": "string",
                      "operation": "notEquals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "execute"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      },
      "id": "action-switch",
      "name": "Action Required?",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        140,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://anasbukhori.app.n8n.cloud/webhook/cs-adm-v2-action-gateway",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-IUC-Agent-Secret",
              "value": "={{ $vars.N8N_EVENT_SHARED_SECRET }}"
            }
          ]
        },

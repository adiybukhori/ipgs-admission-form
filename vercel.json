{
  "rewrites": [
    {
      "source": "/downloads/Orientation_Background.png",
      "destination": "/assets/email/Orientation_Background.png"
    }
  ],
  "headers": [
    {
      "source": "/downloads/Orientation_Background.png",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"IPGS_Orientation_Background.png\""
        },
        {
          "key": "Content-Type",
          "value": "image/png"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ]
}
